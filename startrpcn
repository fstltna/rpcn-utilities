my $RPCNDIR = "/root/rpcn/target/release";
my $SCREENCMD = "/usr/bin/screen";

# No changes below here...

# Set ENV vars
$ENV{'TERM'} = "xterm-256color";

my $running=`ps ax|grep startrpcn|grep -v grep`;

# check if RPCN startup process is running
if ($running ne "")
{
	print "running '$running'\n";
	print ("Startupscript already running...\n");
	exit (0);
}

while (-1)
{
	chdir $RPCNDIR;
	# check if RPCN process is running
	$running=`ps ax|grep rpcn|grep -v rpcn.gameplayer.club|grep -v startrpcn|grep -v grep|grep -v /root/rpcn-utilities/rmc`;
print "running2 '$running'\n";
	if ($running eq "")
	{
		print "RPCN not running\n";
		# See if they want the server started
		if (! -f "$RPCNDIR/nostart")
		{
			# The Log Entry
			my $datestring = localtime();
			my $TIME="RPCN Down, Restarting: $datestring";
			open(OUTF, ">>$RPCNDIR/RPCNScreen.log") || die "Unable to open $RPCNDIR/RPCNScreen.log for appending";
			print (OUTF "$TIME\n");
			close($OUTF);
			chdir $RPCNDIR;
			print "Starting screen process\n";
			system("$SCREENCMD -fa -S RPCN -d -U -m $RPCNDIR/rpcn");
		}
	}
	# Sleep for 1 minute before checking again
	sleep(60);
}
exit(0);
