#!/usr/bin/perl
use strict;
use warnings;

use UI::Dialog;
use Term::ReadKey;
use Term::ANSIScreen qw(cls);

my $FileEditor = "/bin/nano";
my $InitDName = "/root/rpcn-utilities/startrpcn";
my $RPCN_Source = "/root/rpcn";
my $RPCNDIR = "/root/rpcn/target/release";
my $BackupCommand = "/root/rpcn-utilities/rpcnbackup.pl -snapshot";
my $RPCNLog = "/root/rpcn/rpcn.log";
my $RMCDir = "/root/rpcn-utilities";
my $BackupToolDir = "/root/rpcn-utilities";
my $StartupDir = "/root/rpcn-utilities";
my $UpdateCommand = "/usr/bin/git pull";
my $BinDir = "/root/bin";
my $DEBUG_MODE = "off";
my $PagerCommand = "/usr/bin/less";
my $DiskFreeCmd = "/usr/bin/df -h";
my $MailQueueCmd = "/usr/bin/mailq";
my $ShellCommand = "/usr/bin/bash";
my $UpdateSteps = "$StartupDir/UpdateSteps.txt";

###################################################
# No changes below here
###################################################

my $RMC_ver = "1.0.0";
my $Record = "false";	# Are results saved?
my $TempDir = "/tmp";
my $RobotName = "";
my $BotVersion = "";
my $UserName = "";
my $ServerStatus = "foo";

sub PrintDebugCommand
{
	if ($DEBUG_MODE eq "off")
	{
		return;
	}
	my $PassedString = shift;
	print "About to run:\n$PassedString\n";
	print "Press Enter To Run This:";
	my $entered = <STDIN>;
}

my $d = new UI::Dialog ( backtitle => "RPCN Management Console v$RMC_ver", height => 20, width => 65, listheight => 5,
	order => [ 'ascii', 'cdialog', 'xdialog' ]);

my $windowtitle = "Welcome to the RPCN Management Console!";
my $enjoyedtitle = "We hope you enjoyed RMC!";
my $introtext =
"This is the RPCN Management Console, a utility for RPCN operators
to manage their servers from a text UI rather than the command line.";

$d->msgbox( title => $windowtitle, text => $introtext );

if (($d->state() eq "ESC") || ($d->state() eq "CANCEL"))
{
	exit 0;
}

my $menuselection = "";

sub CheckServerStatus
{
	my $running=`ps ax|grep rpcn|grep -v rpcn.gameplayer.club|grep -v startrpcn|grep -v grep`;
	if ($running ne "")
	{
		$ServerStatus = "Running";
	}
	else
	{
		$ServerStatus = "Stopped";
	}

}

sub DoUpdate
{
	my $DesiredDir = $_[0];

	# Update desired utility
	chdir ($DesiredDir);
	PrintDebugCommand("Running $UpdateCommand in $DesiredDir\n");
	system("$UpdateCommand");
	print "Press Enter To Continue";
	my $entered = <STDIN>;
}

sub SystemUtilMenu
{
	my $WantRespawn="ON";
	CheckServerStatus();
	if (-f "$RPCNDIR/nostart")
	{
		$WantRespawn="OFF";
	}
	$menuselection = $d->menu( title => "System Utilities Menu", text => "Server is $ServerStatus and respawn is $WantRespawn - Select one:",
                            list => [ '1', 'Linux Users',
                                      '2', 'Active Processes',
                                      '3', 'Login History',
                                      '4', 'Disk Free',
                                      '5', 'Mail Queue',
                                      'q', 'Main Menu' ] );
}

sub SystemUtilities
{
	while (-1)
	{
		SystemUtilMenu();
		if (($menuselection eq "CANCEL") || ($menuselection eq "ESC") || ($menuselection eq "") || ($menuselection eq "q") || ($menuselection eq "Q"))
		{
			return;
		}
		elsif ($menuselection eq "1")
		{
			# Who's logged in and system load
			system("clear");
                        system("w");
                        print "Press Enter To Continue:";
                        my $entered = <STDIN>;
		}
		elsif ($menuselection eq "2")
		{
			# Display active processes
			system("clear");
                        print "Press \"q\" To Exit. Press Enter To Continue:";
                        my $entered = <STDIN>;
                        system("top");
		}
		elsif ($menuselection eq "3")
		{
			# Linux Login History
			system("clear");
                        system("last | $PagerCommand");
		}
		elsif ($menuselection eq "4")
		{
			# Disk Space
			system("clear");
	                system("$DiskFreeCmd");
                        print "Press Enter To Continue:";
                        my $entered = <STDIN>;
		}
		elsif ($menuselection eq "5")
		{
			# Disk Space
			system("clear");
	                system("$MailQueueCmd");
                        print "Press Enter To Continue:";
                        my $entered = <STDIN>;
		}
	}
}

sub UpdateToolsMenu
{
	my $WantRespawn="ON";
	CheckServerStatus();
	if (-f "$RPCNDIR/nostart")
	{
		$WantRespawn="OFF";
	}
	$menuselection = $d->menu( title => "Update Utilities Menu", text => "Server is $ServerStatus and respawn is $WantRespawn - Select one:",
                            list => [ '1', 'Update Utilities',
                                      'q', 'Main Menu' ] );
}

sub UpdateTools
{
	while (-1)
	{
		UpdateToolsMenu();
		if (($menuselection eq "CANCEL") || ($menuselection eq "ESC") || ($menuselection eq "") || ($menuselection eq "q") || ($menuselection eq "Q"))
		{
			return;
		}
		elsif ($menuselection eq "1")
		{
			# Update RMC
			DoUpdate($RMCDir);
		}
	}
}

sub DoRPCNUpdate
{
	# Rebuild RPCN
	system("clear");
	print "Do you want to pull updates from the repo (N/y): ";
	my $entered = <STDIN>;
	chop($entered);
	if (($entered eq "y") || ($entered eq "Y"))
	{
		$entered = "";
		chdir($RPCN_Source);
		system("touch $RPCNDIR/nostart");
		my $running=`ps ax|grep rpcn|grep -v rpcn.gameplayer.club|grep -v startrpcn|grep -v grep`;
		if ($running ne "")
		{
			# Process is running, kill it
			print "Killing RPCN process:\n";
			system("killall rpcn");
			sleep(5);
		}
		system("git pull");
	}
	print "Did it work? If not address the issues and rerun this step again.\nPress Enter \"y\" To Continue: ";
	$entered = <STDIN>;
	chop($entered);
	if (($entered ne "y") && ($entered ne "Y"))
	{
		return;
	}
	print "Do you want to recompile RPCN? (N/y): ";
	$entered = <STDIN>;
	chop($entered);
	if (($entered eq "y") || ($entered eq "Y"))
	{
		chdir($RPCN_Source);
		system("cargo build --release");
	}
	print "All done! Press ENTER to continue: ";
	$entered = <STDIN>;
	system("rm $RPCNDIR/nostart");
}

sub UpdateRPCNMenu
{
	my $WantRespawn="ON";
	CheckServerStatus();
	if (-f "$RPCNDIR/nostart")
	{
		$WantRespawn="OFF";
	}

	$menuselection = $d->menu( title => "RPCN Update Menu", text => "Server is $ServerStatus and respawn is $WantRespawn - Select one:",
                            list => [ '1', 'How to Update',
                                      '2', 'Backup RPCN',
                                      '3', 'Update RPCN',
                                      'q', 'Main Menu' ] );
}

sub UpdateRPCN
{
	while (-1)
	{
		UpdateRPCNMenu();
		if (($menuselection eq "CANCEL") || ($menuselection eq "ESC") || ($menuselection eq "") || ($menuselection eq "q") || ($menuselection eq "Q"))
		{
			return;
		}
		elsif ($menuselection eq "1")
		{
			# Display the update steps
			system("clear");
			system("$PagerCommand $UpdateSteps");
		}
		elsif ($menuselection eq "2")
		{
			# Run a backup
			system("clear");
			system("$BackupCommand");
			print "Press Enter To Continue";
			my $entered = <STDIN>;
		}
		elsif ($menuselection eq "3")
		{
			# Do the update
			DoRPCNUpdate();
		}
	}
}

sub ProcesKillMenu
{
        my $WantRespawn="ON";
        CheckServerStatus();
        if (-f "$RPCNDIR/nostart")
        {
                $WantRespawn="OFF";
        }

        $menuselection = $d->menu( title => "Process Kill Menu", text => "Server is $ServerStatus and respawn is $WantRespawn - Select one:",
                            list => [ '1', 'Request Clean',
                                      '2', 'Force Kill',
                                      'q', 'Main Menu' ] );
}

sub ProcessKill
{
        while (-1)
        {
		CheckServerStatus();
                ProcesKillMenu();
                if (($menuselection eq "CANCEL") || ($menuselection eq "ESC") || ($menuselection eq "") || ($menuselection eq "q") || ($menuselection eq "Q"))
                {
                        return;
                }
                elsif ($menuselection eq "1")
                {
			if ($ServerStatus eq "Running")
			{
				# Reset the server process
				print "Killing mud process, please wait...";
				system("killall rpcn");
				sleep(10);
			}
			else
			{
				print "Process not running...";
				sleep(3)
			}

                }
                elsif ($menuselection eq "2")
                {
                        # Force-kill server process
                        if ($d->yesno( text => "Confirm force-killing RPCN process", text => "Are you *SURE* you want to force kill the RPCN process?\nYou should first try the \#1 option and see if that works" ))
                        {
				if ($ServerStatus eq "Running")
				{
					print "Force-killing mud process, please wait for 5 seconds...";
					system("killall -s9 rpcn");
					sleep(5);
				}
				else
				{
					print "Process not running...";
					sleep(3)
				}
                        }
                }
        }
}

sub MainMenu
{
	my $WantRespawn="ON";
	CheckServerStatus();
	if (-f "$RPCNDIR/nostart")
	{
		$WantRespawn="OFF";
	}

	$menuselection = $d->menu( title => "Main Menu", text => "Server is $ServerStatus and respawn is $WantRespawn - Select one:",
                            list => [ '1', 'Start Watchdog',
                                      '2', 'Stop Watchdog',
                                      '3', 'Server Console',
                                      '4', 'Turn Respawn Off',
                                      '5', 'Turn Respawn On',
                                      '6', 'Edit rpcn.cfg',
                                      '7', 'Edit scoreboards',
                                      '8', 'Edit server_redirs.cfg',
                                      '9', 'Edit servers.cfg',
                                      '10', 'Backup RPCN',
                                      '11', 'View RPCN Log',
                                      '12', 'Kill RPCN Process',
                                      '13', 'Update Utils',
                                      '14', 'Update RPCN',
                                      '15', 'Ubuntu Version',
                                      '16', 'Utilities',
                                      '17', 'Spawn Shell',
                                      'q', 'Quit RMC' ] );
}

while (-1)
{
	MainMenu();
	if (($menuselection eq "CANCEL") || ($menuselection eq "ESC") || ($menuselection eq "") || ($menuselection eq "q") || ($menuselection eq "Q"))
	{
		$d->msgbox( title => $enjoyedtitle, text => "Thanks for using RMC..." );
		exit 0;
	}
	if ($menuselection eq "1")
	{
                if ($d->yesno( text => "Confirm starting the server watchdog", text => "Are you sure you want to start the server watchdog? You should likely use option #10 instead..." ))
                {
                        system("$InitDName start");
                        sleep(10);
                }
	}
	elsif ($menuselection eq "2")
	{
		if ($d->yesno( text => "Confirm stopping the server watchdog", text => "Are you sure you want to shut down the server watchdog?" ))
		{
			system("$InitDName stop");
			sleep(5);
		}
	}
	elsif ($menuselection eq "3")
	{
		$d->msgbox( text => "To exit the RPCN console and return to RMC press CTRL-A CTRL-D" );
		system("screen -r RPCN");
	}
	elsif ($menuselection eq "4")
	{
		# Turn off respawn
		system("touch $RPCNDIR/nostart");
	}
	elsif ($menuselection eq "5")
	{
		# Turn respawn back on
		if (-f "$RPCNDIR/nostart")
		{
			unlink("$RPCNDIR/nostart");
		}
	}
	elsif ($menuselection eq "6")
	{
		# Edit rpcn.cfg file
		system("$FileEditor $RPCNDIR/rpcn.cfg");
	}
	elsif ($menuselection eq "7")
	{
		# Edit scoreboards file
		system("$FileEditor $RPCNDIR/scoreboards.cfg");
	}
	elsif ($menuselection eq "8")
	{
		# Edit server_redirs.cfg file
		system("$FileEditor $RPCNDIR/server_redirs.cfg");
	}
	elsif ($menuselection eq "9")
	{
		# Edit servers.cfg file
		system("$FileEditor $RPCNDIR/servers.cfg");
	}
	elsif ($menuselection eq "10")
	{
                # Run a backup
                system("clear");
                system("$BackupCommand");
                print "Press Enter To Continue";
                my $entered = <STDIN>;
	}
	elsif ($menuselection eq "11")
	{
                # View the log file
                system("$PagerCommand $RPCNLog");
	}
	elsif ($menuselection eq "12")
	{
		ProcessKill();
	}
	elsif ($menuselection eq "13")
	{
		# Update Menu
		UpdateTools();
	}
	elsif ($menuselection eq "14")
	{
		# Update RPCN
		UpdateRPCN();
	}
	elsif ($menuselection eq "15")
	{
		# Display Ubuntu version
                system("clear");
		system("$RMCDir/ubuntuversion");
		print "Press Enter To Continue: ";
		my $entered = <STDIN>;
	}
	elsif ($menuselection eq "16")
	{
		# Run utilities
		SystemUtilities();
	}
	elsif ($menuselection eq "17")
	{
		# Run bash shell
		system("clear");
		print "About to spawn a shell. Enter \"exit\" to exit and return to RMC\n";
		print "Press Enter To Continue:";
		my $entered = <STDIN>;
		system("clear");
		chdir("$ENV{HOME}");
		system("$ShellCommand");
	}
}

exit 0;
